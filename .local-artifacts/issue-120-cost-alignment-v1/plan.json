  "rules": {
    "alignment": "per cost over every complete evaluation branch: Pearson r (phi) of the verdict with (i) the #113 settle flag at the trace's last frame (settle_1, observable_macro.shot_labels on the stored #113 summaries) and (ii) the present pigs + blocks at the trace's last step (also each kind and verdict (a)); level-clustered bootstrap; within-level r reported beside. The alignment of a cost is |pooled r with the settle flag|",
    "arm_113": "the single pre-declared #113-coordination arm: #120 item 3(a) under #113's redefined macro predicates = the #115 ma-ref predictor's fixed requests under cost (a), same contrast and rule",
    "arms": {
      "controls": [
        "no-model action prior under each cost's fit verdicts (Gate-B rule)",
        "wrong-anchor: Gate-B F-15-macro from the 480 fit anchors over the 16 grid candidates"
      ],
      "gateb": [
        "F-1-continuous",
        "F-1-micro",
        "F-1-macro",
        "F-5-continuous",
        "F-5-micro",
        "F-5-macro",
        "F-15-continuous",
        "F-15-micro",
        "F-15-macro",
        "J",
        "J_dec"
      ],
      "ma-ref": [
        "F-1-continuous",
        "F-1-micro",
        "F-1-macro",
        "F-5-continuous",
        "F-5-micro",
        "F-5-macro",
        "F-15-continuous",
        "F-15-micro",
        "F-15-macro"
      ]
    },
    "cells": "per level x inventory, the complete candidates in ordinal order (Gate-B rule); under each cost the mixed-verdict cells of that cost's verdict; cost (a) cells equal the Gate-B cells",
    "costs": {
      "a": {
        "definition": "engine pig removal of the branch (#104 campaign branches.json pig_removed, #85 engine channel); model cost = the #111 tie-free primary at frame 225: pig presence - 0.1 x pig-slot centre displacement",
        "name": "current (pig removal)"
      },
      "b": {
        "definition": "at least 1 block entity destroyed (engine entity_destroyed) during the shot, i.e. fewer blocks survive than the level starts with; model cost at frame 225 = sum over the block slots of presence - 0.1 x sum over the block slots of centre displacement (the tie-free form on the blocks)",
        "name": "structure (block destroyed)"
      },
      "c": {
        "definition": "summed displacement of the dynamic blocks and the pig from frame 0 to their last present native step >= 0.5 world units; model cost at frame 225 = minus the summed block- and pig-slot centre displacement",
        "name": "motion magnitude (structure displacement)"
      },
      "d": {
        "definition": "engine collision event between the launched bird and a block or the pig at or before frame 150 (native step first_fixed_step + 50 x 150); model cost = minus the summed block- and pig-slot centre displacement at the rollout's last visited frame <= 150",
        "name": "early contact (bird hits structure)"
      }
    },
    "disposition": "\"the macro ranking advantage persists under a verdict not aligned with the macro predicates\": primary: a cost is not aligned iff its alignment (|r| with the settle flag at the endpoint) is below 0.1; c* = the least-aligned such cost in {b, c, d} that passes the mixed-cell guard. supported iff the primary token is supported under (a) and under c*; not_supported_by_this_experiment iff either is not_supported_by_this_experiment; otherwise (or without an eligible c*) readiness_or_precision_insufficient. Reported beside it, as sensitivity readings with the same token logic: sensitivity: eligible iff the alignment (settle flag) is below the control's; c* = the least aligned eligible cost; sensitivity: alignment = max(|r settle flag|, |r presence count|); eligible iff below the control's; c* = the least aligned eligible cost",
    "guards": {
      "G1_isolation": "verdicts and scores from the evaluation stream only; fit only as priors; wrong anchors from the fit roster",
      "G2_scoring_policy": "every record carries the #111 SCORING_POLICY",
      "G3_chronology": "plan frozen_at <= evaluation verdicts derived_at <= first scored_at",
      "G4_bindings": "predictor, policy and anchor-store hashes equal their published bindings",
      "G5_replication": "under (a) on the Gate-B cells every retained row equals the #101 record of the arm, the Gate-B wrong-anchor rows and the #115 ma-ref default macro records exactly",
      "G6_verdicts": "the event-derived #85 pig channel equals the campaign's pig_removed on every branch; the #113 summary frame counts equal the traces'; module bytes frozen",
      "G7_nonfinite": "at most 10% excluded rows per record",
      "failure": "a failed guard turns every token into readiness_or_precision_insufficient"
    },
    "mixed_cell_guard": "a cost with fewer than 42 mixed grid cells (levels) is readiness_or_precision_insufficient for every token of that cost; it is reported, not dropped",
    "primary": "per cost, grid: mean over Delta in {1, 5, 15} of AUC(F-Delta-macro) - AUC(F-Delta-continuous) of the Gate-B LC hybrid, paired per (level, seed), level-clustered bootstrap; token by the delta rule (supported iff mean >= 0.02 and lower > 0; not_supported_by_this_experiment iff upper < 0.02; otherwise readiness_or_precision_insufficient); each Delta and the other inventories DESCRIPTIVE",
    "rollouts": "one rollout per (predictor, arm, seed, level, inventory) from the Gate-B anchor to frame 225 under deterministic_scoring(); the frame-225 carrier and the last visited carrier at or before frame 150 feed the four model costs (cost_verdicts.DEFINITIONS)",
    "thresholds": {
      "blocks_destroyed_min": 1,
      "displacement_min_world_units": 0.5,
      "early_frames": 150
    },
    "verdict_source": "retained native traces of the executed #104 campaign branches (cost_verdicts.branch_quantities); (a) the campaign's pig_removed; the evaluation stream is derived after the freeze and before the first score, the fit stream in the smoke (priors only)"
  },
