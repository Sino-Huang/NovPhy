{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation_trace_v1.schema.json",
  "title": "NovPhy synchronized observation trace manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "exposure_role",
    "scenario_lineage_identity",
    "source_bindings",
    "observation_configuration",
    "frame_records",
    "access_policy"
  ],
  "properties": {
    "schema": {"const": "observation_trace_manifest_v1"},
    "identity": {"type": "string", "minLength": 1},
    "exposure_role": {
      "enum": ["training", "calibration", "model_selection", "final_evaluation"]
    },
    "scenario_lineage_identity": {"type": "string", "minLength": 1},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "observation_configuration": {"$ref": "#/$defs/configuration"},
    "frame_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frameRecord"}
    },
    "access_policy": {
      "const": {
        "agent": "central_model_workflows",
        "canonical": "alignment_or_capture_diagnosis_only"
      }
    }
  },
  "$defs": {
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_template_identity",
        "level_instance_identity",
        "source_scenario_lineage_identity",
        "rollout_identity"
      ],
      "properties": {
        "scenario_template_identity": {"type": "string", "minLength": 1},
        "level_instance_identity": {"type": "string", "minLength": 1},
        "source_scenario_lineage_identity": {"type": "string", "minLength": 1},
        "rollout_identity": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "name", "canonical_representation", "agent_representation", "identity"
      ],
      "properties": {
        "schema": {"const": "observation_configuration_v1"},
        "name": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "canonical_representation": {"$ref": "#/$defs/representation"},
        "agent_representation": {
          "allOf": [
            {"$ref": "#/$defs/representation"},
            {
              "type": "object",
              "required": ["transform"],
              "properties": {"transform": {"$ref": "#/$defs/transform"}}
            }
          ]
        }
      }
    },
    "representation": {
      "type": "object",
      "required": ["role", "stage", "media_type", "pixel_format"],
      "properties": {
        "role": {"enum": ["agent", "canonical"]},
        "stage": {"enum": ["pre_transform", "post_transform"]},
        "media_type": {"const": "image/png"},
        "pixel_format": {"const": "rgb8_srgb"}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "output_width_pixels", "output_height_pixels", "resampling"],
      "properties": {
        "method": {"enum": ["identity", "resize"]},
        "output_width_pixels": {"type": ["integer", "null"], "minimum": 1},
        "output_height_pixels": {"type": ["integer", "null"], "minimum": 1},
        "resampling": {"enum": ["none", "nearest"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "stage", "relative_path", "media_type", "pixel_format",
        "width_pixels", "height_pixels", "content_identity",
        "synchronization_identity", "observation_configuration_identity", "identity"
      ],
      "properties": {
        "role": {"enum": ["agent", "canonical"]},
        "stage": {"enum": ["pre_transform", "post_transform"]},
        "relative_path": {"type": "string", "minLength": 1},
        "media_type": {"const": "image/png"},
        "pixel_format": {"const": "rgb8_srgb"},
        "width_pixels": {"type": "integer", "minimum": 1},
        "height_pixels": {"type": "integer", "minimum": 1},
        "content_identity": {"type": "string", "minLength": 1},
        "synchronization_identity": {"type": "string", "minLength": 1},
        "observation_configuration_identity": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "frameRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "source_frame_identity", "synchronization_identity",
        "render_frame", "render_time_seconds", "fixed_step", "fixed_time_seconds",
        "capture_metadata", "agent_observation", "canonical_observation"
      ],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "source_frame_identity": {"type": "string", "minLength": 1},
        "synchronization_identity": {"type": "string", "minLength": 1},
        "render_frame": {"type": "integer", "minimum": 0},
        "render_time_seconds": {"type": "number"},
        "fixed_step": {"type": "integer", "minimum": 0},
        "fixed_time_seconds": {"type": "number"},
        "capture_metadata": {"$ref": "#/$defs/captureMetadata"},
        "agent_observation": {"$ref": "#/$defs/artifact"},
        "canonical_observation": {"$ref": "#/$defs/artifact"}
      }
    },
    "matrix16": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {"type": "number"}
    },
    "captureMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "capture_id", "sequence", "source_frame_identity",
        "render_frame", "render_time_seconds", "fixed_step", "fixed_time_seconds",
        "source", "camera", "viewport", "coordinates", "world_to_observation_transform"
      ],
      "properties": {
        "schema_version": {"const": "observation_capture_engine_v1"},
        "capture_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "source_frame_identity": {"type": "string", "minLength": 1},
        "render_frame": {"type": "integer", "minimum": 0},
        "render_time_seconds": {"type": "number"},
        "fixed_step": {"type": "integer", "minimum": 0},
        "fixed_time_seconds": {"type": "number"},
        "source": {"const": "synchronized_observation_endpoint"},
        "camera": {"type": "object"},
        "viewport": {"type": "object"},
        "coordinates": {"type": "object"},
        "world_to_observation_transform": {"type": "object"}
      }
    }
  }
}
