    verify_payload(payload)

    fifo_archive = root / 'fifo.tar.gz'
    with tarfile.open(fifo_archive, 'w:gz') as bundle:
        member = tarfile.TarInfo('special-fifo')
        member.type = tarfile.FIFOTYPE
        member.mode = 0o600
        bundle.addfile(member)
    unpacked = root / 'unpacked'
