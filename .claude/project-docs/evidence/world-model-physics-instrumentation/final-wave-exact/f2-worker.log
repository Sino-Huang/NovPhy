with tempfile.TemporaryDirectory(prefix='novphy-f2-adversarial-') as temporary:
    root = Path(temporary)
    stage = root / 'stage'
    stage.mkdir()
    outside = root / 'outside.tar.gz'
    with tarfile.open(outside, 'w:gz'):
        pass
    digest = hashlib.sha256(outside.read_bytes()).hexdigest()
    (stage / 'archive.sha256').write_text(f'{digest}  ../outside.tar.gz\n', encoding='ascii')
    resolved_archive, _ = archive_from_stage(stage)
    receipt_escape_accepted = resolved_archive.resolve() == outside.resolve()

    payload = root / 'payload'
    payload.mkdir()
    secret = root / 'secret.bin'
    secret.write_bytes(b'secret')
    manifest = {
        'schema_version': 'novphy_physics_player_stage_v1',
