import json
import socket
import struct
import threading

from src.webui.bridge import (
    LegacyGroundTruthProtocolError,
    ScienceBirdsBridge,
    _decode_physics_capture_v1,
    encode_physics_capture_v1,
)

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind(("127.0.0.1", 0))
server.listen(1)
observed = {}

def serve():
    with server:
        connection, _ = server.accept()
        with connection:
            observed["request62"] = connection.recv(1).hex()
            connection.sendall(struct.pack("!I", 7) + b"{}xxxxx")
            observed["request38"] = connection.recv(21).hex()
            connection.sendall(struct.pack("!I", 10_001) + b"unread-record")
            observed["closed_after_reject"] = connection.recv(1) == b""

worker = threading.Thread(target=serve, daemon=True)
worker.start()
bridge = ScienceBirdsBridge("127.0.0.1", server.getsockname()[1], timeout=2.0)
bridge.connect()
observed["legacy_state"] = bridge.get_symbolic_state_without_screenshot()
try:
    bridge.shoot_and_record_ground_truth(1, 2, tap_time=4, release_time=3)
except LegacyGroundTruthProtocolError as error:
    observed["typed_error"] = {
        "request_code": error.request_code,
        "field": error.field,
        "value": error.value,
        "limit": error.limit,
    }
else:
    raise AssertionError("oversized request-38 count was accepted")
worker.join(timeout=2)
assert not worker.is_alive()
assert observed["request62"] == "3e"
assert observed["request38"] == struct.pack("!Biiiii", 38, 1, 2, 3, 4, 1).hex()
assert observed["legacy_state"] == {}
assert observed["closed_after_reject"] is True
wire = encode_physics_capture_v1(
    b"\x89PNG\r\n\x1a\nframe",
    {"schema_version": "physics_capture_v1", "render_frame": 42, "nodes": []},
    [{"schema_version": "physics_capture_v1", "render_frame": 42}],
)
capture = _decode_physics_capture_v1(wire[4:])
assert capture.state["render_frame"] == 42
assert capture.events[0]["render_frame"] == 42
observed["request70_render_frame"] = 42
print(json.dumps(observed, sort_keys=True))
