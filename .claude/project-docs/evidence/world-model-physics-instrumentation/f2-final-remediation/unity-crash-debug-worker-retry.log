PRIVATE_LD="${EDITOR%/Editor/Unity}/Editor/Data/Tools:${EDITOR%/Editor/Unity}/Editor"
TMP_PROJECT="/tmp/unity-crash-debug-empty-510501"
run_probe() {
  label="$1"
  logfile="$EVIDENCE/$2"
  shift 2
  {
    printf 'probe=%s\n' "$label"
    printf 'started_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'editor=%s\n' "$EDITOR"
    printf 'editor_version=2019.4.41f2\n'
    printf 'cwd=%s\n' "$PWD"
    printf 'shell_LD_LIBRARY_PATH=%s\n' "${LD_LIBRARY_PATH-}"
    printf 'probe_LD_LIBRARY_PATH=%s\n' "$PRIVATE_LD"
    printf 'DISPLAY=%s\n' "${DISPLAY-}"
    printf 'XDG_RUNTIME_DIR=%s\n' "${XDG_RUNTIME_DIR-}"
    printf 'HOME=%s\n' "${HOME-}"
    printf 'ulimit_core=%s\n' "$(ulimit -c)"
    printf 'command=env LD_LIBRARY_PATH=%q timeout --signal=TERM --kill-after=5s 60s %q ' "$PRIVATE_LD" "$EDITOR"
    printf '%q ' "$@"
    printf '\n--- unity output ---\n'
  } > "$logfile"
  env LD_LIBRARY_PATH="$PRIVATE_LD" timeout --signal=TERM --kill-after=5s 60s "$EDITOR" "$@" >> "$logfile" 2>&1
  probe_exit=$?
  {
    printf '%s\n' '--- result ---'
    printf 'finished_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'exit_status=%s\n' "$probe_exit"
    if [ "$probe_exit" -ge 128 ] && [ "$probe_exit" -le 192 ]; then printf 'signal=%s\n' "$(kill -l $((probe_exit-128)) 2>/dev/null || true)"; else printf 'signal=none\n'; fi
  } >> "$logfile"
}
run_probe "no-project-disable-gpu-force-gfx-st" probe-2.log -batchmode -nographics -disable-gpu -force-gfx-st -quit
run_probe "fresh-empty-project" probe-3.log -batchmode -nographics -quit -projectPath "$TMP_PROJECT"
printf '%s\n' "temp_project=$TMP_PROJECT" > "$EVIDENCE/probe-run-metadata.txt"
printf '%s\n' 'probe_count=3' >> "$EVIDENCE/probe-run-metadata.txt"
printf '%s\n' "completed_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$EVIDENCE/probe-run-metadata.txt"
exit 0
