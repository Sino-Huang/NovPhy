[0m$ [0mset +e
EVIDENCE="/mnt/array/sukaih/Project/.novphy-worktrees/physics-unity-2019.4/.omo/evidence/world-model-physics-instrumentation/f2-final-remediation/unity-crash-debug"
EDITOR="/home/sukai/.local/share/novphy-unity/2019.4.41f2-6b23d448b533/editor/Editor/Unity"
PRIVATE_LD="${EDITOR%/Editor/Unity}/Editor/Data/Tools:${EDITOR%/Editor/Unity}/Editor"
TMP_PROJECT="/tmp/unity-crash-debug-empty-$$"
printf '\n## Probe artifacts (journaled before creation)\n- [ ] %s/probe-1.log; %s/probe-2.log; %s/probe-3.log — remove after audit\n- [ ] %s — temporary empty project; remove after audit\n- [ ] Unity locks, cores, and caches under probe temp/runtime paths — remove after audit\n' "$EVIDENCE" "$EVIDENCE" "$EVIDENCE" "$TMP_PROJECT" >> "$EVIDENCE/debug-journal.md"
mkdir -p "$TMP_PROJECT/ProjectSettings" "$TMP_PROJECT/Packages"
printf '%s\n' 'm_EditorVersion: 2019.4.41f2' > "$TMP_PROJECT/ProjectSettings/ProjectVersion.txt"
printf '%s\n' '{"dependencies":{}}' > "$TMP_PROJECT/Packages/manifest.json"
ulimit -c 0
run_probe() {
  label="$1"
  logfile="$EVIDENCE/$2"
  shift 2
  {
    printf 'probe=%s\n' "$label"
    printf 'started_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'editor=%s\n' "$EDITOR"
    printf 'editor_version=2019.4.41f2\n'
    printf 'cwd=%s\n' "$PWD"
    printf 'shell_LD_LIBRARY_PATH=%s\n' "${LD_LIBRARY_PATH-}"
    printf 'probe_LD_LIBRARY_PATH=%s\n' "$PRIVATE_LD"
    printf 'DISPLAY=%s\n' "${DISPLAY-}"
    printf 'XDG_RUNTIME_DIR=%s\n' "${XDG_RUNTIME_DIR-}"
    printf 'HOME=%s\n' "${HOME-}"
    printf 'ulimit_core=%s\n' "$(ulimit -c)"
    printf 'command=%q ' env LD_LIBRARY_PATH="$PRIVATE_LD" timeout --signal=TERM --kill-after=5s 60s "$EDITOR" "$@"
    printf '\n--- unity output ---\n'
  } > "$logfile"
  env LD_LIBRARY_PATH="$PRIVATE_LD" timeout --signal=TERM --kill-after=5s 60s "$EDITOR" "$@" >> "$logfile" 2>&1
  status=$?
  {
    printf '%s\n' '--- result ---'
    printf 'finished_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'exit_status=%s\n' "$status"
    if [ "$status" -ge 128 ] && [ "$status" -le 192 ]; then printf 'signal=%s\n' "$(kill -l $((status-128)) 2>/dev/null || true)"; else printf 'signal=none\n'; fi
  } >> "$logfile"
}
run_probe "no-project-nographics" probe-1.log -batchmode -nographics -quit
run_probe "no-project-disable-gpu-force-gfx-st" probe-2.log -batchmode -nographics -disable-gpu -force-gfx-st -quit
