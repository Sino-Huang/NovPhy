+    private static bool IsLocallyClosed(TcpClient client)
+    {
+        try
+        {
+            client.GetStream();
+            return false;
+        }
+        catch (ObjectDisposedException)
+        {
+            return true;
+        }
+        catch (InvalidOperationException)
+        {
+            return true;
+        }
+    }
