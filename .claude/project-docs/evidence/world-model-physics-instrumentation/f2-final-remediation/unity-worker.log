out 60 \\\n    --prepare-timeout 90 \\\n    --read-timeout 420 \\\n    --speed 1 \\\n    --game-dir "$worker_engine_dir" \\\n    --port 2004 \\\n    --engine-agent-port 2004 \\\n    --engine-game-port 9001\n  then\n    :\nelse\n    status=$?\n    record_failure train levels/one.xml /tmp/tmpsu4wkhy8/out/train/episode-one "$status"\n    failure_count=$((failure_count + 1))\n  fi\nfi\n\n  fi\n  if [[ "$failure_count" -gt 0 ]]; then return 1; fi\n  return 0\n}\nworker_pids=()\nrun_worker 0 :149 &\nworker_pids+=("$!")\nfor worker_pid in "${worker_pids[@]}"; do\n  if ! wait "$worker_pid"; then failure_count=$((failure_count + 1)); fi\ndone\nif [[ "$failure_count" -gt 0 ]]; then exit 1; fi\necho "Completed newly scheduled train/dev episodes. Failure ledger: $failure_ledger"\n'
