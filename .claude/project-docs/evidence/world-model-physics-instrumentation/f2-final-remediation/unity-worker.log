+    private static IEnumerator TransmitResponse(TcpClient client, byte[] response)
+    {
+        if (response == null || response.Length > PhysicsCaptureV1Protocol.MaxEnvelopeBytes)
+        {
+            client.Close();
+            yield break;
+        }
+
+        NetworkStream stream = client.GetStream();
+        IAsyncResult write;
+        try
+        {
+            write = stream.BeginWrite(response, 0, response.Length, null, null);
+        }
+        catch (IOException)
+        {
+            client.Close();
+            yield break;
+        }
+        catch (ObjectDisposedException)
+        {
+            yield break;
+        }
+
+        Stopwatch deadline = Stopwatch.StartNew();
+        while (!write.IsCompleted && deadline.ElapsedMilliseconds < ResponseWriteTimeoutMilliseconds)
+            yield return null;
+        if (!write.IsCompleted)
+        {
+            client.Close();
+            yield break;
+        }
+
+        try
+        {
+            stream.EndWrite(write);
+        }
+        catch (IOException)
+        {
+            client.Close();
+        }
+        catch (ObjectDisposedException)
+        {
+        }
+    }
+
